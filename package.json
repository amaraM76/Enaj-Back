{
  "name": "enaj-api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "dotenv -e .env.local -- next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "postinstall": "prisma generate",
    "prisma:push:local": "dotenv -e .env.local -- npx prisma db push",
    "prisma:push:prod": "npx prisma db push",
    "prisma:migrate:prod": "npx prisma migrate deploy",
    "prisma:studio:local": "dotenv -e .env.local -- npx prisma studio --port 5555",
    "prisma:studio:prod": "npx prisma studio --port 5556",
    "prisma:generate": "dotenv -e .env.local -- npx prisma generate",
    "encrypt:backfill": "tsx scripts/encrypt-existing-data.ts",
    "products:dedupe": "tsx scripts/dedupe-products.ts",
    "products:dedupe:apply": "tsx scripts/dedupe-products.ts --apply"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.0.7",
    "@prisma/client": "^5.22.0",
    "bcrypt": "^5.1.1",
    "next": "^16.1.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/node": "^20.16.0",
    "@types/react": "^18.3.8",
    "dotenv-cli": "^11.0.0",
    "prisma": "^5.22.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.6.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
