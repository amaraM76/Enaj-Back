{
  "name": "enaj-api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start -p ${PORT:-3001}",
    "lint": "next lint",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "bcrypt": "^5.1.1",
    "next": "^16.1.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/node": "^20.16.0",
    "@types/react": "^18.3.8",
    "dotenv-cli": "^11.0.0",
    "prisma": "5.22.0",
    "typescript": "^5.6.0"
  },
  "prisma": {
    "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
  },
  "scripts": {
    "dev": "dotenv -e .env.local -- next dev",
    "build": "next build",
    "start": "next start",
  
    "prisma:push:local": "dotenv -e .env.local -- npx prisma db push",
    "prisma:push:prod": "npx prisma db push",
  
    "prisma:studio:local": "dotenv -e .env.local -- npx prisma studio",
    "prisma:studio:prod": "npx prisma studio"
  }
}
